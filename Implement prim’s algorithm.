# Implementation of Prim's Algorithm

INF = float('inf')

def prim(graph, start):
    n = len(graph)
    selected = [False] * n
    selected[start] = True

    total_cost = 0
    print("Edges in the Minimum Spanning Tree:")

    for _ in range(n - 1):
        min_weight = INF
        u = -1
        v = -1

        for i in range(n):
            if selected[i]:
                for j in range(n):
                    if not selected[j] and graph[i][j] < min_weight:
                        min_weight = graph[i][j]
                        u = i
                        v = j

        if u == -1:
            print("Graph is disconnected!")
            return

        print(f"{u} - {v} : {min_weight}")
        total_cost += min_weight
        selected[v] = True

    print("Total cost of Minimum Spanning Tree:", total_cost)


# Graph represented using an adjacency matrix
graph = [
    [0, 2, 0, 6, 0],
    [2, 0, 3, 8, 5],
    [0, 3, 0, 0, 7],
    [6, 8, 0, 0, 9],
    [0, 5, 7, 9, 0]
]

# Start from vertex 0
prim(graph, 0)
